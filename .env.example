# Railway 3x-UI Deployer Bot - Environment Variables

# Required: Your Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# Optional: Docker image to deploy (default: ghcr.io/wiwwiwiwiwiwi/3x_ui_amir:latest)
REPO_IMAGE=ghcr.io/wiwwiwiwiwiwi/3x_ui_amir:latest

# Optional: Project name on Railway (default: 3x-ui-amir)
PROJECT_NAME=3x-ui-amir
